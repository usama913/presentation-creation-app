<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No third-party NuGet packages on purpose: this project talks to the
      OpenAI / Anthropic REST APIs with plain HttpClient + System.Text.Json.
      FrameworkReference pulls in Microsoft.Extensions.* (DI, Options,
      Http, Logging) from the locally installed ASP.NET Core shared
      framework, not from NuGet.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gamma.Core\Gamma.Core.csproj" />
  </ItemGroup>

</Project>
